{
  "name": "specrail",
  "version": "0.1.0",
  "private": true,
  "description": "Specrail turns API specs and docs into governed capabilities for agents.",
  "author": "Gerry Miller <gerry@gerrymiller.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gerrymiller/specrail.git"
  },
  "homepage": "https://github.com/gerrymiller/specrail",
  "bugs": {
    "url": "https://github.com/gerrymiller/specrail/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
