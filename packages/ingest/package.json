{
  "name": "@specrail/ingest",
  "version": "0.1.0",
  "description": "OpenAPI spec parsing, docs fetching, and Context7 augmentation for Specrail",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@specrail/core": "workspace:*",
    "openapi-types": "^12.1.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "author": "Gerry Miller <gerry@gerrymiller.com>"
}
